# Local-development template only. Never commit API credentials.
# The AI provider URL and request contract will be wired after the server API details are supplied.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Local Vite demo mode defaults to enabled in development. Set false to require Forge bridge integration.
VITE_DEMO_MODE=true

# Backend-only Forge allowlists. Empty configuration denies application access.
# Local Vite environment files do not configure these values in the Forge runtime.
CONTROL_TOWER_EXECUTIVE_ACCOUNT_IDS=
CONTROL_TOWER_OPERATOR_ACCOUNT_IDS=
CONTROL_TOWER_ADMIN_ACCOUNT_IDS=

# Required for scheduled app-context Jira sync. User-triggered sync uses the authenticated user's Jira access.
JIRA_PROJECT_KEY=
