# Local-development template only. Never commit API credentials.
# The AI provider URL and request contract will be wired after the server API details are supplied.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Local Vite demo mode defaults to enabled in development. Set false to require Forge bridge integration.
VITE_DEMO_MODE=true

# Forge runtime role allowlists (comma-separated Atlassian account IDs; configure as Forge variables).
CONTROL_TOWER_EXECUTIVE_ACCOUNT_IDS=
CONTROL_TOWER_OPERATOR_ACCOUNT_IDS=
